FROM ghcr.io/mlflow/mlflow:v2.14.1

RUN pip install --no-cache-dir \
    psycopg2-binary \
    google-cloud-storage \
    gcsfs \
    "protobuf==3.20.*"

# Verify imports work at build time so failures are caught here, not at pod start
RUN python -c "import mlflow; import google.cloud.storage; import gcsfs; print('OK')"
